{
  "name": "av-converter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@mui/material": "^7.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "scripts": {
    "test": "vitest run",
    "deploy": "yarn install && yarn build",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy-all": "yarn build && docker compose -f docker/prod/docker-compose.yml up -d --build --remove-orphans && docker compose -f docker/prod/docker-compose.yml exec --no-tty nginx nginx -s reload",
    "deploy-src": "yarn build",
    "docker-down": "docker compose -f docker/prod/docker-compose.yml down",
    "docker-logs": "docker compose -f docker/prod/docker-compose.yml logs -f",
    "docker-dev": "docker compose -f docker/dev/docker-compose.yml up --build --watch"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "25.0.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.4.5",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
